    {
      "type": "text",
      "id": "vm_invoice_text",
      "x": 65,
      "y": 418,
      "width": 350,
      "height": 265,
      "text": "InvoiceView\n────────────────────────\nInvoiceID          ← from Invoice\nInvoiceDate        ← from Invoice\nCustomerID         ← from Invoice (hidden)\nEmployeeID         ← from Invoice (hidden)\nCustomerName       ← from Customer\nEmployeeName       ← from Employee\nSubTotal           ← from Invoice\nTax                ← from Invoice\nTotal              ← COMPUTED",
      "originalText": "InvoiceView\n────────────────────────\nInvoiceID          ← from Invoice\nInvoiceDate        ← from Invoice\nCustomerID         ← from Invoice (hidden)\nEmployeeID         ← from Invoice (hidden)\nCustomerName       ← from Customer\nEmployeeName       ← from Employee\nSubTotal           ← from Invoice\nTax                ← from Invoice\nTotal              ← COMPUTED",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
